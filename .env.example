# Copy to .env (gitignored) and fill in real values for local runs.
# In GitHub Actions these come from repo secrets/vars instead.

# --- JIRA (Cloud) ---
JIRA_BASE_URL=https://your-tenant.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# --- Clockify ---
CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=
CLOCKIFY_PROJECT_ID=
CLOCKIFY_TAG_ID=

# Optional. If unset the sync resolves it via /api/v1/user on each run.
CLOCKIFY_USER_ID=

# --- Behavior ---
# IANA timezone name. Default America/Mexico_City (GMT-6, no DST).
TIMEZONE=America/Mexico_City
